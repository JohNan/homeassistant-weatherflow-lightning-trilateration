# Mark the built Lovelace card JS as a generated file.
# GitHub will collapse diffs for it and linguist won't count it as source.
# Source of truth: src/weatherflow-lightning-card.ts (bundles three.js and the
# vendored postprocessing addons under src/vendor/three-jsm/ at build time).
custom_components/weatherflow_lightning_trilateration/dist/weatherflow-lightning-card.js linguist-generated=true

# Vendored third-party three.js postprocessing addon modules (r128), used to
# build the SSAO post-processing pass. Not written by this project and never
# hand-edited, so mark them both generated and vendored: GitHub collapses
# diffs, excludes them from language stats, and they won't be suggested in
# code review.
src/vendor/three-jsm/** linguist-generated=true linguist-vendored=true
